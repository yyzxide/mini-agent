{
  "name": "mini-coding-agent",
  "version": "0.1.0",
  "description": "A local conversational AI coding agent CLI.",
  "type": "module",
  "bin": {
    "mini-agent": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "benchmarks",
    "README.md",
    "mini-agent.config.example.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:regression": "vitest run tests/cli-regression.test.ts tests/cli-real-api-regressions.test.ts",
    "bench": "npm run build --silent && node dist/cli/index.js bench run benchmarks/agent-bench-v1.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "verify": "npm run check:architecture && npm run check:exports && npm run check:docs && npm run build && npm run lint:unused && npm test",
    "verify:regression": "npm run check:architecture && npm run check:exports && npm run check:docs && npm run build && npm run test:regression"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "commander": "^14.0.2",
    "execa": "^9.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
